<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Resultado do Cadastro</title>
</head>
<body>
    <h2>Informações do Aluno</h2>

    <?php
    // Recebendo dados do formulário (POST)
    $nome = $_POST['nome'];
    $idade = $_POST['idade'];
    $turma = $_POST['turma'];
    $nota1 = $_POST['nota1'];
    $nota2 = $_POST['nota2'];

    // Calculando média
    $media = ($nota1 + $nota2) / 2;

    // Verificando aprovação
    if ($media >= 6) {
        $situacao = "Aprovado ✅";
    } else {
        $situacao = "Reprovado ❌";
    }

    // Exibindo os dados
    echo "<strong>Nome:</strong> $nome<br>";
    echo "<strong>Idade:</strong> $idade<br>";
    echo "<strong>Turma:</strong> $turma<br>";
    echo "<strong>Nota 1:</strong> $nota1<br>";
    echo "<strong>Nota 2:</strong> $nota2<br>";
    echo "<strong>Média:</strong> $media<br>";
    echo "<strong>Situação:</strong> $situacao<br><br>";

    // Recebendo e exibindo informações via GET
    $campanha = $_GET['campanha'];
    $versao = $_GET['versao'];

    echo "<h3>Informações adicionais (GET):</h3>";
    echo "Campanha: $campanha<br>";
    echo "Versão: $versao<br>";
    ?>
</body>
</html>
