    // Funções de navegação
    function skipWelcome() {
      document.getElementById('welcome-page').style.display = 'none';
      document.getElementById('login-page').style.display = 'flex';
    }

    setTimeout(function() {
      document.getElementById('welcome-page').style.display = 'none';
      document.getElementById('login-page').style.display = 'flex';
    }, 3000);

    function showRecoveryPage() {
      document.getElementById('login-page').style.display = 'none';
      document.getElementById('recovery-page').style.display = 'flex';
    }

    function showLoginPage() {
      document.getElementById('recovery-page').style.display = 'none';
      document.getElementById('register-page').style.display = 'none';
      document.getElementById('dashboard-page').style.display = 'none';
      document.getElementById('login-page').style.display = 'flex';
      document.getElementById('recoveryForm').reset();
      document.getElementById('successMessage').style.display = 'none';
      document.getElementById('registerForm').reset();
      document.getElementById('register-success-message').style.display = 'none';
    }

    function showRegisterPage() {
      document.getElementById('login-page').style.display = 'none';
      document.getElementById('register-page').style.display = 'flex';
    }

    // Função para fazer login e mostrar o dashboard
    function login() {
      const username = document.getElementById('username').value;
      const password = document.getElementById('password').value;
      
      // Validação básica
      if (!username || !password) {
        alert('Por favor, preencha todos os campos');
        return;
      }
      
      // Simulação de login bem-sucedido
      document.getElementById('login-page').style.display = 'none';
      document.getElementById('dashboard-page').style.display = 'block';
      
      // Atualizar informações do usuário no dashboard
      document.getElementById('user-name').textContent = username;
      document.getElementById('user-avatar').textContent = username.charAt(0).toUpperCase();
    }

    // Adicionar evento de submit ao formulário de login
    document.querySelector('.login-form').addEventListener('submit', function(e) {
      e.preventDefault();
      login();
    });

    document.getElementById('recoveryForm').addEventListener('submit', function(e) {
      e.preventDefault();
      document.getElementById('successMessage').style.display = 'block';
      document.getElementById('recoveryForm').style.display = 'none';
      setTimeout(function() { showLoginPage(); }, 4000);
    });

    document.getElementById('registerForm').addEventListener('submit', function(e) {
      e.preventDefault();
      const password = document.getElementById('register-password').value;
      const confirmPassword = document.getElementById('confirm-password').value;
      if (password !== confirmPassword) { 
        alert('Passwords do not match!'); 
        return; 
      }
      document.getElementById('register-success-message').style.display = 'block';
      document.getElementById('registerForm').style.display = 'none';
      setTimeout(function() { showLoginPage(); }, 3000);
    });

    // Funções do seletor de idioma
    function toggleLanguageDropdown(page) {
      const dropdown = document.getElementById(`languageDropdown-${page}`);
      const allDropdowns = document.querySelectorAll('.language-dropdown');
      allDropdowns.forEach(dd => { if (dd !== dropdown) dd.style.display = 'none'; });
      dropdown.style.display = dropdown.style.display === 'flex' ? 'none' : 'flex';
    }

    function getLanguageName(lang) {
      const languageNames = {
        'pt': 'Português',
        'en': 'English', 
        'fr': 'Français',
        'ko': '한국어'
      };
      return languageNames[lang];
    }

