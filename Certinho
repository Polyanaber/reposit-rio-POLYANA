    // Funções do Modal de Termos
    function showTermsModal(type) {
      event.preventDefault();
      const modal = document.getElementById('terms-modal');
      const title = document.getElementById('terms-modal-title');
      const content = document.getElementById('terms-content');
      const t = translations[currentLanguage];
      if (type === 'terms') {
        title.textContent = t.modalTermsTitle;
        content.innerHTML = getTermsContent(currentLanguage);
      } else if (type === 'privacy') {
        title.textContent = t.modalPrivacyTitle;
        content.innerHTML = getPrivacyContent(currentLanguage);
      }
      document.getElementById('modal-terms-checkbox').checked = false;
      document.getElementById('modal-privacy-checkbox').checked = false;
      document.getElementById('modal-age-checkbox').checked = false;
      document.getElementById('modal-accept-button').disabled = true;
      modal.style.display = 'flex';
    }

    function closeTermsModal() { document.getElementById('terms-modal').style.display = 'none'; }

    function acceptTerms() {
      document.getElementById('terms').checked = true;
      closeTermsModal();
    }

    document.getElementById('modal-terms-checkbox').addEventListener('change', updateAcceptButton);
    document.getElementById('modal-privacy-checkbox').addEventListener('change', updateAcceptButton);
    document.getElementById('modal-age-checkbox').addEventListener('change', updateAcceptButton);

    function updateAcceptButton() {
      const termsChecked = document.getElementById('modal-terms-checkbox').checked;
      const privacyChecked = document.getElementById('modal-privacy-checkbox').checked;
      const ageChecked = document.getElementById('modal-age-checkbox').checked;
      document.getElementById('modal-accept-button').disabled = !(termsChecked && privacyChecked && ageChecked);
