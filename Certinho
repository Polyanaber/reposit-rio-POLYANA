      document.getElementById('modal-age-label').textContent = t.modalAgeLabel;
      document.getElementById('modal-accept-button').textContent = t.modalAcceptButton;
      document.getElementById('modal-cancel-button').textContent = t.modalCancelButton;
      
      // Dashboard translations
      if (document.getElementById('dashboard-title')) {
        document.getElementById('dashboard-title').textContent = t.dashboardTitle;
        document.getElementById('user-name').textContent = t.userName;
        document.getElementById('logout-btn').textContent = t.logoutBtn;
        document.getElementById('welcome-dashboard-title').textContent = t.welcomeDashboardTitle;
        document.getElementById('welcome-dashboard-subtitle').textContent = t.welcomeDashboardSubtitle;
        document.getElementById('quick-agenda').textContent = t.quickAgenda;
        document.getElementById('quick-tasks').textContent = t.quickTasks;
        document.getElementById('quick-timer').textContent = t.quickTimer;
        document.getElementById('quick-notes').textContent = t.quickNotes;
      }
      
      // Atualiza o texto do idioma atual em todos os seletores
      document.querySelectorAll('[id^="current-language-"]').forEach(el => { 
        el.textContent = lang.toUpperCase(); 
      });
      
      // Remove a classe active de todas as opções e adiciona apenas na selecionada
      document.querySelectorAll('.language-option').forEach(option => { 
        option.classList.remove('active'); 
        if (option.textContent === getLanguageName(lang)) {
          option.classList.add('active');
        }
      });
      
      // Fecha todos os dropdowns
      document.querySelectorAll('.language-dropdown').forEach(dropdown => { 
        dropdown.style.display = 'none'; 
      });
    }

    document.addEventListener('click', function(event) {
      if (!event.target.closest('.language-selector')) {
        document.querySelectorAll('.language-dropdown').forEach(dropdown => { dropdown.style.display = 'none'; });
