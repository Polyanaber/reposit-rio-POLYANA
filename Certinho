<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SmartMind - Estudos Inteligentes</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary-color: #130229;
      --primary-dark: #6d0448;
      --accent-color: #ff0077;
      --text-dark: #d4d4d4;
      --text-light: #ffffff;
      --button-bg: rgba(28, 104, 190, 0.3);
      --button-hover: rgba(91, 22, 75, 0.5);
      --transition: all 0.3s cubic-bezier(0.42, 0, 0.13, 1.19);
      --dashboard-bg: linear-gradient(183deg, #130229 0%, hwb(295 3% 73%) 50%, #6d0448 100%);
      --card-bg: rgba(255, 255, 255, 0.1);
      --card-hover: rgba(255, 255, 255, 0.15);
      --success-color: #00ff88;
      --warning-color: #ffaa00;
      --error-color: #ff4444;
      --info-color: #72168e;
    }
    
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; overflow: hidden; }
    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: linear-gradient(189deg, var(--primary-color), var(--primary-dark));
      font-family: 'Poppins', Arial, sans-serif;
      padding: 20px;
      position: relative;
      color: var(--text-dark);
    }
    
    .bg-effects {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: -1;
      overflow: hidden;
    }
    
    .floating-element {
      position: absolute;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 50%;
      animation: floatAround 20s infinite linear;
    }
    
    .floating-element:nth-child(1) { width: 80px; height: 80px; top: 10%; left: 10%; animation-duration: 25s; }
    .floating-element:nth-child(2) { width: 120px; height: 120px; top: 60%; right: 10%; animation-duration: 30s; animation-direction: reverse; }
    .floating-element:nth-child(3) { width: 60px; height: 60px; bottom: 20%; left: 20%; animation-duration: 20s; }
    
    /* CONTAINER PRINCIPAL RESPONSIVO */
    .container, #login-page, #recovery-page, #register-page, #dashboard-page {
      width: 100%;
      max-width: 400px;
      min-height: 600px;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 30px 20px;
      position: relative;
    }

    /* DASHBOARD ESPECÍFICO */
    #dashboard-page {
      max-width: 100vw;
      max-height: 100vh;
      min-height: 100vh;
      padding: 0;
      overflow-y: auto;
      background: var(--dashboard-bg);
      justify-content: flex-start;
      display: none;
    }

    /* AJUSTES PARA TELAS MUITO PEQUENAS */
    @media (max-height: 600px) {
      .container, #login-page, #recovery-page, #register-page {
        min-height: 500px;
        max-height: 95vh;
        padding: 20px 15px;
        justify-content: flex-start;
        padding-top: 40px;
      }
      
      .header { margin-top: 80px !important; }
      .robot-container { margin-top: 30px !important; }
      .subtitle { font-size: clamp(2.2rem, 8vw, 4rem) !important; }
    }

    /* AJUSTES PARA TABLETS E NOTEBOOKS */
    @media (min-width: 768px) and (max-width: 1024px) {
      .container, #login-page, #recovery-page, #register-page {
        max-width: 450px;
        min-height: 700px;
      }
      
      .header { margin-top: 140px; }
      .robot-container { margin-top: 50px; }
      .subtitle { font-size: clamp(3rem, 8vw, 4.5rem) !important; }
      
      .robot {
        width: min(250px, 60vw) !important;
        max-width: 50% !important;
      }
      .robot-glow {
        width: min(260px, 65vw) !important;
        height: min(260px, 65vw) !important;
      }
    }

    /* AJUSTES PARA DESKTOPS GRANDES */
    @media (min-width: 1025px) {
      .container, #login-page, #recovery-page, #register-page {
        max-width: 500px;
        min-height: 750px;
      }
      
      .header { margin-top: 160px; }
      .robot-container { margin-top: 60px; }
    }

    .header { 
      width: 100%; 
      animation: fadeInDown 0.8s ease-out;
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 120px;
    }
    
    .title { display: none; }
    
    .subtitle {
      font-size: clamp(2.8rem, 10vw, 5.5rem);
      color: var(--text-light);
      line-height: 1;
      font-weight: 1000;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
      margin-bottom: 13px;
      display: block;
      text-align: center;
      width: 100%;
    }
    
    .tagline { 
      font-size: 1.1rem; 
      color: var(--text-dark); 
      margin-top: 10px; 
      font-weight: 300; 
      opacity: 0.9; 
    }
    
    .robot-container {
      margin: 0;
      animation: float 3s ease-in-out infinite;
      position: relative;
      z-index: 2;
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      margin-top: 60px;
    }
    
    .robot {
      width: min(230px, 70vw);
      max-width: 46%;
      filter: drop-shadow(0 10px 35px rgba(0, 0, 0, 0.3)) drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
      transition: var(--transition);
      cursor: pointer;
    }
    
    .robot-glow {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: min(240px, 75vw);
      height: min(240px, 75vw);
      background: radial-gradient(circle, rgba(203, 77, 155, 0.3) 0%, transparent 70%);
      border-radius: 90%;
      z-index: -1;
      animation: pulseGlow 2s ease-in-out infinite alternate;
    }
    
    .loading-dots { 
      display: flex; 
      gap: 10px; 
      margin-bottom: 30px; 
    }
    
    .dot { width: 20px; height: 20px; border-radius: 50%; animation: bounce 1.2s infinite; }
    .dot:nth-child(1) { background: #560368; }
    .dot:nth-child(2), .dot:nth-child(3), .dot:nth-child(4) { background: #9c0fb8; }
    .dot:nth-child(1) { animation-delay: 0s; }
    .dot:nth-child(2) { animation-delay: 0.2s; }
    .dot:nth-child(3) { animation-delay: 0.4s; }
    .dot:nth-child(4) { animation-delay: 0.6s; }
    
    .swipe-indicator { 
      display: flex; 
      flex-direction: column; 
      align-items: center; 
      margin-bottom: 20px; 
      opacity: 0.7; 
      animation: pulse 2s infinite; 
    }
    
    .swipe-text { font-size: 1.2rem; margin-bottom: 5px; }

    /* PÁGINAS DE FORMULÁRIO */
    #login-page, #recovery-page, #register-page {
      display: none;
      overflow-y: auto;
    }
    
    #register-page { 
      padding-top: 20px !important; 
      padding-bottom: 20px !important; 
      justify-content: flex-start !important; 
    }

    .login-header, .recovery-header, .register-header { 
      width: 100%; 
      text-align: center; 
    }
    
    .login-header { margin-bottom: 40px; }
    .recovery-header, .register-header { margin-bottom: 30px; }
    .register-header { margin-bottom: 20px !important; }

    .login-title { font-size: 2.5rem; font-weight: 700; color: var(--text-light); margin-bottom: 10px; }
    .recovery-title, .register-title { font-size: 2rem; font-weight: 700; color: var(--text-light); margin-bottom: 15px; }

    .login-subtitle, .recovery-subtitle, .register-subtitle {
      font-size: 1rem;
      color: var(--text-dark);
      font-weight: 300;
      line-height: 1.5;
      max-width: 300px;
      margin: 0 auto;
    }
    
    .recovery-subtitle, .register-subtitle { font-size: 0.9rem; max-width: 320px; }

    .login-form, .recovery-form, .register-form { 
      width: 100%; 
      display: flex; 
      flex-direction: column; 
      gap: 20px; 
    }
    
    .register-form { 
      gap: 15px; 
      margin-top: 10px !important; 
      margin-bottom: 10px !important; 
    }

    .form-group { display: flex; flex-direction: column; text-align: left; }
    .form-label { font-size: 0.9rem; color: var(--text-light); margin-bottom: 8px; font-weight: 500; }
    
    .form-input {
      padding: 15px;
      background: rgba(113, 20, 20, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 8px;
      color: var(--text-light);
      font-size: 1rem;
      transition: var(--transition);
    }
    
    .form-input:focus { outline: none; border-color: var(--accent-color); background: rgba(255, 255, 255, 0.15); }

    .login-button, .recovery-button, .register-button {
      padding: 15px;
      background: var(--accent-color);
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 500;
      cursor: pointer;
      transition: var(--transition);
      margin-top: 10px;
    }
    
    .login-button:hover, .recovery-button:hover, .register-button:hover { background: #e0006a; transform: translateY(-2px); }

    .login-links { display: flex; justify-content: space-between; margin-top: 15px; }
    .link { color: var(--accent-color); text-decoration: none; font-size: 0.9rem; transition: var(--transition); cursor: pointer; }
    .link:hover { text-decoration: underline; }

    .register-section { margin-top: 40px; text-align: center; }
    .register-text { font-size: 0.9rem; color: var(--text-dark); margin-bottom: 10px; }
    .register-link { color: var(--text-light); font-weight: 500; text-decoration: none; transition: var(--transition); cursor: pointer; }
    .register-link:hover { color: var(--accent-color); }

    .back-link {
      color: var(--text-light);
      text-decoration: none;
      font-size: 0.9rem;
      margin-top: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      transition: var(--transition);
      cursor: pointer;
    }
    
    .back-link:hover { color: var(--accent-color); }

    .success-message {
      display: none;
      background: rgba(255, 255, 255, 0.1);
      padding: 20px;
      border-radius: 10px;
      border-left: 4px solid #00ff88;
      margin-top: 20px;
      text-align: center;
      animation: fadeInDown 0.5s ease-out;
    }
    
    .success-icon { font-size: 2rem; margin-bottom: 10px; color: #00ff88; }

    /* ROBÔS DAS OUTRAS PÁGINAS - RESPONSIVOS */
    .login-robot, .recovery-robot, .register-robot { 
      width: min(160px, 50vw) !important; 
      max-width: 60% !important; 
    }
    
    .recovery-robot, .register-robot { 
      width: min(140px, 45vw) !important; 
      max-width: 55% !important; 
    }
    
    .login-robot-glow { 
      width: min(180px, 55vw) !important; 
      height: min(180px, 55vw) !important; 
    }
    
    .recovery-robot-glow, .register-robot-glow { 
      width: min(160px, 50vw) !important; 
      height: min(160px, 50vw) !important; 
    }
    
    .recovery-robot-glow { background: radial-gradient(circle, rgba(0, 255, 136, 0.3) 0%, transparent 70%); }
    .register-robot-glow { background: radial-gradient(circle, rgba(0, 200, 255, 0.3) 0%, transparent 70%); }

    /* LANGUAGE SELECTOR RESPONSIVO */
    .language-selector { 
      position: absolute; 
      top: 20px; 
      right: 20px; 
      z-index: 1000; 
    }
    
    @media (max-width: 480px) {
      .language-selector {
        top: 15px;
        right: 15px;
      }
      .language-button {
        padding: 6px 10px;
        font-size: 0.7rem;
      }
    }

    .language-button {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 20px;
      padding: 8px 12px;
      color: var(--text-light);
      font-size: 0.8rem;
      cursor: pointer;
      transition: var(--transition);
      display: flex;
      align-items: center;
      gap: 5px;
    }
    
    .language-button:hover { background: rgba(255, 255, 255, 0.2); transform: scale(1.05); }

    .language-dropdown {
      position: absolute;
      top: 100%;
      right: 0;
      margin-top: 5px;
      background: rgba(19, 2, 41, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 8px;
      padding: 10px;
      display: none;
      flex-direction: column;
      gap: 5px;
      min-width: 120px;
      backdrop-filter: blur(10px);
    }
    
    .language-option { padding: 8px 12px; border-radius: 5px; cursor: pointer; transition: var(--transition); font-size: 0.8rem; color: var(--text-light); }
    .language-option:hover { background: rgba(255, 255, 255, 0.1); }
    .language-option.active { background: var(--accent-color); color: white; }

    /* TERMS SECTION */
    .terms-section { margin-top: 15px; text-align: left; }
    .terms-checkbox { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 10px; }
    .terms-text { font-size: 0.8rem; color: var(--text-dark); line-height: 1.4; }
    .terms-link { color: var(--accent-color); text-decoration: none; }
    .terms-link:hover { text-decoration: underline; }

    .terms-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.7); z-index: 10000; justify-content: center; align-items: center; padding: 20px; }
    
    .terms-modal-content {
      background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
      border-radius: 15px;
      width: 100%;
      max-width: 500px;
      max-height: 80vh;
      overflow-y: auto;
      padding: 30px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      position: relative;
      animation: fadeInDown 0.5s ease-out;
    }
    
    .terms-modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 15px; }
    .terms-modal-title { font-size: 1.5rem; color: var(--text-light); font-weight: 700; }
    .terms-close { background: none; border: none; color: var(--text-light); font-size: 1.5rem; cursor: pointer; transition: var(--transition); }
    .terms-close:hover { color: var(--accent-color); transform: scale(1.1); }
    .terms-content { color: var(--text-dark); line-height: 1.6; font-size: 0.9rem; }
    .terms-section-title { color: var(--text-light); margin: 20px 0 10px; font-size: 1.1rem; font-weight: 600; }
    .terms-list { margin-left: 20px; margin-bottom: 15px; }
    .terms-list li { margin-bottom: 8px; }
    .terms-highlight { background: rgba(255, 255, 255, 0.1); padding: 15px; border-radius: 8px; margin: 15px 0; border-left: 3px solid var(--accent-color); }
    .terms-checkbox-group { margin: 20px 0; text-align: left; }
    .terms-checkbox-item { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 15px; }
    .terms-checkbox-item input[type="checkbox"] { margin-top: 3px; }
    .terms-checkbox-label { font-size: 0.9rem; color: var(--text-light); line-height: 1.4; }
    .terms-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 25px; }
    .terms-button { padding: 10px 20px; border-radius: 8px; font-size: 0.9rem; font-weight: 500; cursor: pointer; transition: var(--transition); }
    .terms-button.cancel { background: rgba(255, 255, 255, 0.1); color: var(--text-light); border: 1px solid rgba(255, 255, 255, 0.2); }
    .terms-button.cancel:hover { background: rgba(255, 255, 255, 0.2); }
    .terms-button.accept { background: var(--accent-color); color: white; border: none; }
    .terms-button.accept:hover { background: #e0006a; transform: translateY(-2px); }
    .terms-button.accept:disabled { background: rgba(255, 255, 255, 0.2); color: rgba(255, 255, 255, 0.5); cursor: not-allowed; transform: none; }

    /* =================== DASHBOARD STYLES =================== */
    
    /* Dashboard Container */
    #dashboard-page {
      display: none;
      position: relative;
      width: 100vw;
      height: 100vh;
      overflow-y: auto;
      background: var(--dashboard-bg);
      padding: 0;
    }

    /* Dashboard Header - MODIFICADO PARA ATENDER AO PEDIDO */
    .dashboard-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(19, 2, 41, 0.95);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding: 10px 20px; /* Reduzido de 15px para 10px */
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .dashboard-logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .dashboard-robot {
      width: 40px;
      height: 40px;
      border-radius: 50%; /* Mantido redondo */
      background: linear-gradient(135deg, #ff0077, #9c0fb8);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      animation: pulseGlow 2s ease-in-out infinite alternate;
    }

    .dashboard-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-light);
      margin: 0;
      padding: 8px 16px; /* Adicionado padding para criar um fundo arredondado */
      background: rgba(255, 255, 255, 0.1); /* Adicionado fundo para destacar */
      border-radius: 20px; /* Arredondado conforme solicitado */
      transition: var(--transition);
    }

    .dashboard-user {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .user-avatar {
      width: 35px;
      height: 35px;
      border-radius: 50%; /* Mantido redondo */
      background: linear-gradient(135deg, #00aaff, #0066cc);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 600;
      font-size: 0.9rem;
    }

    .user-name {
      color: var(--text-light);
      font-weight: 500;
      font-size: 0.9rem;
    }

    .logout-btn {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: var(--text-light);
      padding: 8px 15px;
      border-radius: 20px; /* Arredondado conforme solicitado */
      cursor: pointer;
      transition: var(--transition);
      font-size: 0.8rem;
    }

    .logout-btn:hover {
      background: rgba(255, 0, 119, 0.2);
      border-color: var(--accent-color);
    }

    /* Dashboard Content */
    .dashboard-content {
      padding: 30px 20px;
      max-width: 1200px;
      margin: 0 auto;
    }

    /* Welcome Section */
    .welcome-section {
      text-align: center;
      margin-bottom: 40px;
      animation: fadeInDown 0.8s ease-out;
    }

    .welcome-title {
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--text-light);
      margin-bottom: 10px;
      background: linear-gradient(135deg, #ff0077, #00aaff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .welcome-subtitle {
      font-size: 1.1rem;
      color: var(--text-dark);
      margin-bottom: 30px;
    }

    /* Quick Actions */
    .quick-actions {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 20px;
      margin-bottom: 40px;
      animation: fadeInUp 0.8s ease-out 0.2s both;
    }

    .quick-action {
      background: var(--card-bg);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 15px;
      padding: 20px;
      text-align: center;
      cursor: pointer;
      transition: var(--transition);
      backdrop-filter: blur(10px);
    }

    .quick-action:hover {
      background: var(--card-hover);
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(255, 0, 119, 0.2);
    }

    .quick-action-icon {
      font-size: 2rem;
      margin-bottom: 10px;
      display: block;
    }

    .quick-action-title {
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text-light);
      margin: 0;
    }

    /* Menu Grid */
    .menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 25px;
      margin-bottom: 40px;
    }

    .menu-item {
      background: var(--card-bg);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      padding: 25px;
      cursor: pointer;
      transition: var(--transition);
      backdrop-filter: blur(10px);
      position: relative;
      overflow: hidden;
    }

    .menu-item::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--accent-color), #00aaff);
      transform: scaleX(0);
      transition: transform 0.3s ease;
    }

    .menu-item:hover::before {
      transform: scaleX(1);
    }

    .menu-item:hover {
      background: var(--card-hover);
      transform: translateY(-8px);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
    }

    .menu-item-header {
      display: flex;
      align-items: center;
      gap: 15px;
      margin-bottom: 15px;
    }

    .menu-item-icon {
      width: 50px;
      height: 50px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      color: white;
      background: linear-gradient(135deg, var(--accent-color), #9c0fb8);
    }

    .menu-item-title {
      font-size: 1.3rem;
      font-weight: 600;
      color: var(--text-light);
      margin: 0;
    }

    .menu-item-description {
      color: var(--text-dark);
      font-size: 0.9rem;
      line-height: 1.5;
      margin-bottom: 15px;
    }

    .menu-item-stats {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.8rem;
      color: var(--text-dark);
    }

    .stat-item {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    /* Specific Menu Item Colors */
