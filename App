<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SmartMind - Estudos Inteligentes</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary-color: #13010d;
      --primary-dark: #7a124e;
      --accent-color: #ff0077;
      --text-dark: #d4d4d4;
      --text-light: #ffffff;
      --button-bg: rgba(85, 61, 74, 0.3);
      --button-hover: rgba(91, 22, 75, 0.5);
      --transition: all 0.3s cubic-bezier(0.42, 0, 0.13, 1.19);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
      overflow: hidden;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
      font-family: 'Poppins', Arial, sans-serif;
      padding: 20px;
      position: relative;
      color: var(--text-dark);
    }

    /* Efeitos de background dinâmico */
    .bg-effects {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: -1;
      overflow: hidden;
    }

    .floating-element {
      position: absolute;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 50%;
      animation: floatAround 20s infinite linear;
    }

    .floating-element:nth-child(1) {
      width: 80px;
      height: 80px;
      top: 10%;
      left: 10%;
      animation-duration: 25s;
    }

    .floating-element:nth-child(2) {
      width: 120px;
      height: 120px;
      top: 60%;
      right: 10%;
      animation-duration: 30s;
      animation-direction: reverse;
    }

    .floating-element:nth-child(3) {
      width: 60px;
      height: 60px;
      bottom: 20%;
      left: 20%;
      animation-duration: 20s;
    }

    .container {
      width: 100%;
      max-width: 400px;
      height: 100%;
      max-height: 800px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      text-align: center;
      padding: 40px 20px;
      position: relative;
    }

    /* Cabeçalho */
    .header {
      width: 100%;
      margin-top: 20px;
      animation: fadeInDown 0.8s ease-out;
    }

    .title {
      font-size: clamp(2.2rem, 5vw, 2.8rem);
      font-weight: 500;
      color: var(--text-light);
      line-height: 1.2;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
      margin-bottom: 5px;
    }

    .subtitle {
      font-size: clamp(2.2rem, 8vw, 5rem);
      color: var(--text-light);
      line-height: 0.9;
      font-weight: 800;
      text-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
      margin-bottom: 10px;
    }

    .tagline {
      font-size: 1.1rem;
      color: var(--text-dark);
      margin-top: 10px;
      font-weight: 300;
      opacity: 0.9;
    }

    /* Container do robô */
    .robot-container {
      margin: 20px 0;
      animation: float 3s ease-in-out infinite;
      position: relative;
      z-index: 2;
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .robot {
      width: min(220px, 70vw);
      max-width: 80%;
      filter: 
        drop-shadow(0 8px 25px rgba(0, 0, 0, 0.3))
        drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
      transition: var(--transition);
      cursor: pointer;
    }

    .robot-glow {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: min(240px, 75vw);
      height: min(240px, 75vw);
      background: radial-gradient(circle, rgba(203, 77, 155, 0.3) 0%, transparent 70%);
      border-radius: 50%;
      z-index: -1;
      animation: pulseGlow 2s ease-in-out infinite alternate;
    }

    /* Loading pontinhos */
    .loading-dots {
      display: flex;
      gap: 10px;
      margin-bottom: 30px;
    }

    .dot {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      animation: bounce 1.2s infinite;
    }

    /* Estado inicial */
    .dot:nth-child(1) { background: #A8044E; } /* ROSA escuro */
    .dot:nth-child(2) { background: #FF3AA5; } /* verde claro */
    .dot:nth-child(3) { background: #FF3AA5; } /* azul claro */
    .dot:nth-child(4) { background: #FF3AA5; } /* rosa claro */

    .dot:nth-child(1) {
      animation-delay: 0s;
    }
    .dot:nth-child(2) {
      animation-delay: 0.2s;
    }
    .dot:nth-child(3) {
      animation-delay: 0.4s;
    }
    .dot:nth-child(4) {
      animation-delay: 0.6s;
    }

    /* Animação */
    @keyframes bounce {
      0%, 80%, 100% {
        transform: scale(0.8);
        opacity: 0.6;
      }
      40% {
        transform: scale(1.2);
        opacity: 1;
        background: #A8044E; /* todos ficam vermelho vivo */
      }
    }

    /* Indicador de swipe */
    .swipe-indicator {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 20px;
      opacity: 0.7;
      animation: pulse 2s infinite;
    }

    .swipe-text {
      font-size: 0.9rem;
      margin-bottom: 5px;
    }

    @keyframes fadeInDown {
      from {
        opacity: 0;
        transform: translateY(-20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes float {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-10px);
      }
    }

    @keyframes floatAround {
      0% {
        transform: translate(0, 0) rotate(0deg);
      }
      25% {
        transform: translate(100px, 50px) rotate(90deg);
      }
      50% {
        transform: translate(50px, 100px) rotate(180deg);
      }
      75% {
        transform: translate(-50px, 50px) rotate(270deg);
      }
      100% {
        transform: translate(0, 0) rotate(360deg);
      }
    }

    @keyframes pulseGlow {
      from {
        opacity: 0.4;
        transform: translate(-50%, -50%) scale(0.9);
      }
      to {
        opacity: 0.7;
        transform: translate(-50%, -50%) scale(1.1);
      }
    }

    @keyframes pulse {
      0%, 100% {
        opacity: 0.7;
      }
      50% {
        opacity: 1;
      }
    }
  </style>
</head>
<body>
  <div class="bg-effects">
    <div class="floating-element"></div>
    <div class="floating-element"></div>
    <div class="floating-element"></div>
  </div>

  <div class="container">
    <div class="header">
      <h1 class="title">Bem-Vindo</h1>
      <p class="subtitle">SmartMind!</p>
    </div>

    <div class="robot-container">
      <div class="robot-glow"></div>
      <img src="c:\Users\alexb\Downloads\robô (1).png" alt="Robô inteligente representando a SmartMind" class="robot">
    </div>

    <div class="swipe-indicator">
      <div class="swipe-text">Seu aprendizado mais inteligente começa aqui!</div>
    </div>

    <!-- Pontinhos de loading no lugar do botão -->
    <div class="loading-dots">
      <div class="dot"></div>
      <div class="dot"></div>
      <div class="dot"></div>
      <div class="dot"></div>
    </div>
  </div>
</body>
</html>
